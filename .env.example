# 复制本文件为 .env 后按需填写。全部留空也能跑通 Demo（内置示例文档 + 抽取式答案）。

# ---------- 文档来源 ----------
# GitHub 仓库，形如 owner/repo 或完整 URL；留空则读取本地 DOCS_DIR
GITHUB_REPO=
GITHUB_BRANCH=main
# 只同步仓库内的某个子目录，例如 docs；留空扫描整个仓库
GITHUB_PATH=
# 私有仓库必填，需要 Contents: Read 权限
GITHUB_TOKEN=
# 允许的文件扩展名
GITHUB_EXTS=.md,.markdown,.txt,.rst,.docx
# 本地文档目录（GITHUB_REPO 为空时生效）
# DOCS_DIR=./data/sample_docs

# ---------- 分块 ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MIN_CHUNK_CHARS=40

# ---------- 检索 ----------
TOP_K=5
CANDIDATE_K=20
RRF_K=60
# off | hashing | openai | local
DENSE_MODE=off
# 向量模型名（DENSE_MODE=openai/local 时生效）
# 百炼用 text-embedding-v3（1024 维）；OpenAI 用 text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-v3
# 单次请求的最大条数。百炼上限 10 条，超了直接 400；换模型时改这里，不用动代码
# EMBEDDING_BATCH=10
# 向量维度。换模型必须同步改，否则和索引里的旧维度对不上会被禁用并提示重建
# EMBEDDING_DIM=1024
MIN_SCORE=0
# 相关性门控阈值：IDF 加权词覆盖率低于它就拒答。设 0 表示关闭。
# 0.24 是在 55 篇语料上实测的安全值；配了 LLM_API_KEY 时门控本来就不生效，交给模型判断
# MIN_COVERAGE=0.24

# ---------- 大模型（任意 OpenAI 兼容服务） ----------
# DeepSeek:  https://api.deepseek.com/v1   / deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1  / qwen-plus
# 智谱:      https://open.bigmodel.cn/api/paas/v4  / glm-4-flash
# Ollama:    http://localhost:11434/v1  / qwen2.5:7b  （API_KEY 随便填个非空值）
# OpenAI:    https://api.openai.com/v1  / gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
MAX_CONTEXT_CHARS=6000

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8765
